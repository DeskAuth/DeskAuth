<?xml version="1.0" encoding="utf-8"?>
<!--
  Package manifest for the Microsoft Store version of DeskAuth. tools/Build-StorePackage.ps1 replaces the
  $NAME$ values: the identity comes from Partner Center (Product identity page), and the version and
  processor from the build. DisplayName must match the name reserved in Partner Center.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="$IDENTITY_NAME$"
    Publisher="$PUBLISHER$"
    Version="$VERSION$"
    ProcessorArchitecture="$ARCHITECTURE$" />

  <Properties>
    <DisplayName>DeskAuth Authenticator</DisplayName>
    <PublisherDisplayName>$PUBLISHER_DISPLAY_NAME$</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <Description>Free, open-source two-factor authenticator for Windows</Description>
  </Properties>

  <Dependencies>
    <!-- Windows 10 version 1809 or later (SupportedOSPlatformVersion in DeskAuth.csproj) -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="DeskAuth" Executable="DeskAuth.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DeskAuth Authenticator"
        Description="Free, open-source two-factor authenticator for Windows"
        BackgroundColor="transparent"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile />
      </uap:VisualElements>

      <Extensions>
        <!-- "deskauth" on the command line, for example to open another config file -->
        <uap3:Extension Category="windows.appExecutionAlias" Executable="DeskAuth.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:AppExecutionAlias>
            <desktop:ExecutionAlias Alias="DeskAuth.exe" />
          </uap3:AppExecutionAlias>
        </uap3:Extension>

        <!-- "Start with Windows" in the options menu; off until the user turns it on -->
        <desktop:Extension Category="windows.startupTask" Executable="DeskAuth.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="DeskAuthStartup" Enabled="false" DisplayName="DeskAuth Authenticator" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- a normal desktop (WPF) app -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
