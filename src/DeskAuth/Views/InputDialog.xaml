<Window x:Class="DeskAuth.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskAuth"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=InputField}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,8" />
        <TextBox x:Name="InputField" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="OK" MinWidth="80" IsDefault="True" Click="OkButton_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
