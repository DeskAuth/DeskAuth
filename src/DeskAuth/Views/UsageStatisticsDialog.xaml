<Window x:Class="DeskAuth.Views.UsageStatisticsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskAuth privacy choices"
        Width="500"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,16"
                   Text="DeskAuth never sends your authenticators, their names, codes or secret keys, your passwords, or anything about the websites you use. Choose whether it may connect to the internet for the following." />

        <!-- hidden in the Microsoft Store version, which the Store updates -->
        <StackPanel x:Name="UpdatesSection">
            <TextBlock TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                       Text="Check for new versions" />
            <CheckBox x:Name="UpdatesCheckBox" IsChecked="True" Margin="0,0,0,4">
                <TextBlock TextWrapping="Wrap" Text="Tell me when a new version of DeskAuth is available" />
            </CheckBox>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,16" Opacity="0.8"
                       Text="Each time DeskAuth starts, it asks GitHub for the latest release. GitHub sees your IP address and the DeskAuth version." />
        </StackPanel>

        <TextBlock TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8"
                   Text="Send anonymous usage statistics?" />
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="They tell us how many people use DeskAuth, and which versions of DeskAuth and Windows to keep supporting." />

        <TextBlock Text="If you agree, once a day when DeskAuth starts it sends:" FontWeight="SemiBold" Margin="0,0,0,4" />
        <TextBlock TextWrapping="Wrap" Margin="12,0,0,12">
            • a random ID created for this copy of DeskAuth<LineBreak />
            • the DeskAuth version<LineBreak />
            • the Windows version and processor type
        </TextBlock>

        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="The statistics are collected with Google Analytics." />

        <TextBlock TextWrapping="Wrap" Opacity="0.8">
            You can change both at any time from the options menu.
            <Hyperlink NavigateUri="https://deskauth.com/privacy.html" RequestNavigate="PrivacyLink_RequestNavigate">Privacy notice</Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Send statistics" MinWidth="120" Click="SendButton_Click" />
            <Button Content="Don't send" MinWidth="120" Margin="8,0,0,0" Click="DontSendButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
