<Window x:Class="DeskAuth.Views.SecretDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Secret key"
        Width="460"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12"
                   Text="Anyone with this key or QR code can generate your codes. Use it only to set up this authenticator on another device." />

        <Border HorizontalAlignment="Center" Background="White" Padding="8" CornerRadius="4">
            <Image x:Name="QrImage" Width="220" Height="220" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        </Border>

        <TextBlock Text="Secret key" Margin="0,16,0,4" />
        <DockPanel>
            <Button Content="Copy" DockPanel.Dock="Right" Margin="8,0,0,0" Click="CopyKey_Click" />
            <TextBox x:Name="KeyField" IsReadOnly="True" FontFamily="Consolas" />
        </DockPanel>

        <TextBlock Text="Link" Margin="0,12,0,4" />
        <DockPanel>
            <Button Content="Copy" DockPanel.Dock="Right" Margin="8,0,0,0" Click="CopyLink_Click" />
            <TextBox x:Name="LinkField" IsReadOnly="True" />
        </DockPanel>

        <Button Content="Close" HorizontalAlignment="Right" MinWidth="80" Margin="0,20,0,0" IsCancel="True" IsDefault="True" />
    </StackPanel>
</Window>
