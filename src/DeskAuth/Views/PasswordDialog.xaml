<Window x:Class="DeskAuth.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskAuth"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=PasswordField}">
    <StackPanel Margin="20">
        <TextBlock x:Name="PromptText" TextWrapping="Wrap" Margin="0,0,0,12" />

        <TextBlock Text="Password" Margin="0,0,0,4" />
        <PasswordBox x:Name="PasswordField" />

        <StackPanel x:Name="ConfirmPanel" Visibility="Collapsed">
            <TextBlock Text="Confirm password" Margin="0,12,0,4" />
            <PasswordBox x:Name="ConfirmField" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Margin="0,8,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button x:Name="RemoveButton" Content="Remove password" DockPanel.Dock="Left"
                    Visibility="Collapsed" Click="RemoveButton_Click" />
            <Button Content="Cancel" DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
            <Button Content="OK" DockPanel.Dock="Right" MinWidth="80" IsDefault="True" Click="OkButton_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </StackPanel>
</Window>
