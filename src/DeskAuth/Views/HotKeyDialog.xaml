<Window x:Class="DeskAuth.Views.HotKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Shortcut key"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=KeyField}">
    <StackPanel Margin="20">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                   Text="Click the box and press the key combination to use from any program, for example Ctrl+Alt+G." />
        <TextBox x:Name="KeyField" IsReadOnly="True" IsReadOnlyCaretVisible="False" FontSize="16"
                 PreviewKeyDown="KeyField_PreviewKeyDown" />

        <TextBlock Text="When pressed" Margin="0,16,0,4" />
        <RadioButton x:Name="InjectRadio" Content="Type the code into the current window" IsChecked="True" />
        <RadioButton x:Name="CopyRadio" Content="Copy the code to the clipboard" Margin="0,6,0,0" />
        <RadioButton x:Name="NotifyRadio" Content="Show the code in a notification" Margin="0,6,0,0" />

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <DockPanel Margin="0,20,0,0" LastChildFill="False">
            <Button Content="Remove" DockPanel.Dock="Left" Click="RemoveButton_Click" />
            <Button Content="Cancel" DockPanel.Dock="Right" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
            <Button Content="OK" DockPanel.Dock="Right" MinWidth="80" IsDefault="True" Click="OkButton_Click"
                    Style="{DynamicResource AccentButtonStyle}" />
        </DockPanel>
    </StackPanel>
</Window>
