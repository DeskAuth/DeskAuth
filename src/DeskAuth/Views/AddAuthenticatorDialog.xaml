<Window x:Class="DeskAuth.Views.AddAuthenticatorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add authenticator"
        Width="520"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FocusManager.FocusedElement="{Binding ElementName=NameField}">
    <StackPanel Margin="20">
        <TextBlock Text="Name" Margin="0,0,0,4" />
        <TextBox x:Name="NameField" />

        <TextBlock TextWrapping="Wrap" Margin="0,16,0,4"
                   Text="Secret key or otpauth:// link. Websites show this as text or a QR code when you set up two-factor authentication." />
        <TextBox x:Name="SecretField" LostFocus="SecretField_LostFocus" TextChanged="SecretField_TextChanged" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Paste QR code image" Click="PasteQrButton_Click" />
            <Button Content="Open QR code image..." Margin="8,0,0,0" Click="OpenQrButton_Click" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <RadioButton x:Name="TotpRadio" Content="Time-based (TOTP)" IsChecked="True" Checked="Type_Changed" />
            <RadioButton x:Name="HotpRadio" Content="Counter-based (HOTP)" Margin="16,0,0,0" Checked="Type_Changed" />
        </StackPanel>

        <Expander x:Name="AdvancedExpander" Header="Advanced" Margin="0,12,0,0">
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <TextBlock Text="Digits" VerticalAlignment="Center" Margin="0,0,12,0" />
                <ComboBox x:Name="DigitsCombo" Grid.Column="1" SelectedIndex="0" SelectionChanged="Options_Changed">
                    <ComboBoxItem Content="6" />
                    <ComboBoxItem Content="7" />
                    <ComboBoxItem Content="8" />
                </ComboBox>
                <TextBlock Text="Algorithm" Grid.Row="1" VerticalAlignment="Center" Margin="0,8,12,0" />
                <ComboBox x:Name="AlgorithmCombo" Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" SelectedIndex="0" SelectionChanged="Options_Changed">
                    <ComboBoxItem Content="SHA1" />
                    <ComboBoxItem Content="SHA256" />
                    <ComboBoxItem Content="SHA512" />
                </ComboBox>
                <TextBlock x:Name="PeriodLabel" Text="Period (seconds)" Grid.Row="2" VerticalAlignment="Center" Margin="0,8,12,0" />
                <TextBox x:Name="PeriodField" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="30" TextChanged="Options_Changed" />
                <TextBlock x:Name="CounterLabel" Text="Counter" Grid.Row="2" VerticalAlignment="Center" Margin="0,8,12,0" Visibility="Collapsed" />
                <TextBox x:Name="CounterField" Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" Text="0" Visibility="Collapsed" TextChanged="Options_Changed" />
            </Grid>
        </Expander>

        <Border Margin="0,16,0,0" Padding="12" CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel>
                <TextBlock x:Name="CodeText" DockPanel.Dock="Right" FontSize="24" FontFamily="Consolas" VerticalAlignment="Center" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                           Text="Check this code matches the one the website asks for." />
            </DockPanel>
        </Border>

        <TextBlock x:Name="ErrorText" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                   TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Add" MinWidth="80" IsDefault="True" Click="OkButton_Click" Style="{DynamicResource AccentButtonStyle}" />
            <Button Content="Cancel" MinWidth="80" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
