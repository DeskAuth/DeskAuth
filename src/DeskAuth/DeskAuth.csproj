<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\deskauth.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>4.0.0</Version>
    <Product>DeskAuth</Product>
    <Description>Authenticator for Windows</Description>
    <Authors>Nick Morphis and contributors</Authors>
    <Copyright>Copyright (C) 2010-2017 Colin Mackie (WinAuth). Copyright (C) 2026 Nick Morphis and contributors (DeskAuth). GPL v3 or later.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskAuth.Core\DeskAuth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\deskauth.ico" />
    <EmbeddedResource Include="Resources\DeskAuthLogo.png" LogicalName="DeskAuthLogo.png" />
    <!-- WinAuth 3 built-in icons, loaded by the file name stored in old config files -->
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
