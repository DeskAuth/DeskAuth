<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\deskauth.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- shown as the file description in Windows; version, product and copyright are in Directory.Build.props -->
    <AssemblyTitle>DeskAuth</AssemblyTitle>
    <Description>Authenticator for Windows</Description>
  </PropertyGroup>

  <!--
    The Microsoft Store version (dotnet publish -p:DeskAuthStore=true, see tools/Build-StorePackage.ps1) uses
    Windows Runtime APIs for its startup task. The downloads don't, so they stay small.
  -->
  <PropertyGroup Condition="'$(DeskAuthStore)' == 'true'">
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <DefineConstants>$(DefineConstants);DESKAUTH_STORE</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskAuth.Core\DeskAuth.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\deskauth.ico" />
    <EmbeddedResource Include="Resources\DeskAuthLogo.png" LogicalName="DeskAuthLogo.png" />
    <!-- WinAuth 3 built-in icons, loaded by the file name stored in old config files -->
    <EmbeddedResource Include="Resources\Icons\*.png" LogicalName="Icons.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
